# Flight Watch settings. Copy to .env and fill in; never commit .env.
# docker compose reads it, and so does the app when run without Docker.
# Tunables (search filters, pacing, alerts) are in config/flighttrack.yaml, not here.

# --- Required ------------------------------------------------------------------

# Timezone. The worker's daily calendar sweep (collect.sweep_at) and its nightly
# backup and housekeeping run on local time.
TZ=America/Los_Angeles

# --- Optional ------------------------------------------------------------------

# SerpApi key for the paid fallback source (a JSON API that runs from someone
# else's address). Empty = off.
SERPAPI_KEY=

# fake = invented prices and no outside requests at all (no Google, no deal
# feeds), for a demo or a smoke test. Leave empty for real collecting.
# FLIGHTTRACK_SOURCE=

# SMTP delivery, used only if config/flighttrack.yaml says notify.channel: smtp.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_TO=

# Where the database, failure pages and backups live when
# running without Docker. Docker uses /data, mounted from ./data.
# DATA_DIR=./data
# DB_PATH=./data/flights.db

# The home airport: the default origin for new trips and searches, and what
# `flighttrack doctor` tests from. An imported file's `home:` wins for its own
# trips and searches.
HOME_AIRPORT=SEA

# --- The web app ------------------------------------------------------------------

# The owner password that unlocks editing: at least 12 characters. Empty (or
# shorter) = the site is read-only for everyone and what is tracked is loaded with
# `flighttrack import-config`. After changing it, end the old sessions with
# `docker compose run --rm worker flighttrack owner logout-all`.
OWNER_PASSWORD=

# The site's public address, e.g. https://flights.example.com. Owner requests
# must come from this site's pages (the Origin header); this names it when a proxy
# changes the Host header.
PUBLIC_URL=

# 1 if Cloudflare or a reverse proxy is in front, so rate limits see each
# visitor's address. Leave 0 when the app is reached directly: otherwise anyone
# could choose their own address by sending the header.
TRUSTED_PROXY=0

# dev = the interactive API docs at /api/docs and cookies over plain http.
# docker-compose.yml sets prod (HTTPS-only cookies, HSTS, no docs) whatever this says.
# ENV=dev

# --- Used from later milestones (harmless until then) ------------------------------

# Push alerts (M8). `flighttrack push keys` will print both lines. Never change
# them once devices have subscribed. CONTACT_EMAIL is how push services can
# reach you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=
