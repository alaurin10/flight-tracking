# crontab -e  (the cron alternative to the systemd timer)
#
# One line does everything; stages are isolated inside `run`. Exit status is
# non-zero if the collector aborted or health is critical, so cron mail (or
# your MAILTO) surfaces it — and `health` pushes to your phone as well.
NTFY_TOPIC=replace-with-a-long-random-topic
15 3 * * *  cd /srv/flighttrack && .venv/bin/flighttrack run >> log/run.log 2>&1

# Optional: a second, deals-only poll in the afternoon (deal posts are
# time-sensitive; price fetches are not). No Google traffic.
0 15 * * *  cd /srv/flighttrack && .venv/bin/flighttrack deals >> log/deals.log 2>&1

# Optional: an independent heartbeat that does not depend on `run` surviving.
0 9 * * *   cd /srv/flighttrack && .venv/bin/flighttrack health --notify >> log/health.log 2>&1
